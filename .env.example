# Local development and deployment environment variables.
# Configure these in Vercel Project Settings > Environment Variables.
# Never commit real credentials.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to support@tuningcurvelabs.com
CONTACT_TO_EMAIL=

# Optional. Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=
